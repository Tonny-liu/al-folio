{% if site.bib_search %}
  <script src="{{ '/assets/js/bibsearch.js' | relative_url | bust_file_cache }}" type="module"></script>
  <div class="bibsearch-form-container">
    <input type="text" id="bibsearch" spellcheck="false" autocomplete="off" class="search bibsearch-form-input" placeholder="Type to filter">
    <button id="bibsearch-clear" class="bibsearch-clear-btn" aria-label="Clear search" title="Clear search">&#10005;</button>
  </div>
  <div id="publication-label-filter" class="publication-label-filter" hidden>
    <div class="publication-label-colorbar">
      <span class="publication-label-count" aria-hidden="true" hidden></span>
      <div id="publication-label-options" class="publication-label-options" role="group" aria-label="Filter publications by label"></div>
      <svg class="publication-label-connector" aria-hidden="true"><path></path></svg>
      <div id="publication-label-captions" class="publication-label-captions" aria-hidden="true"></div>
    </div>
  </div>
{% endif %}
